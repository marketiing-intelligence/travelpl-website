---
export const prerender = false;
import AdminLayout from '../../../layouts/AdminLayout.astro';
import TripForm from '../../../components/admin/TripForm.astro';
import { getTrips } from '../../../lib/trips';

const { slug } = Astro.params;
const trips = await getTrips();
const trip = trips.find((t) => t.slug === slug);
if (!trip) return Astro.redirect('/admin');
---

<AdminLayout title={`Edycja: ${trip.fullName} — Panel TravelPL`}>
  <div class="mb-6">
    <a href="/admin" class="text-sm text-slate-500 hover:text-blue-600">← Wróć do listy</a>
    <h1 class="text-2xl font-bold mt-1">Edycja: {trip.fullName}</h1>
  </div>
  <TripForm mode="edit" trip={trip} />
</AdminLayout>
