---
export const prerender = false;
import AdminLayout from '../../layouts/AdminLayout.astro';
import { getTrips } from '../../lib/trips';

const trips = await getTrips();
const regionLabels: Record<string, string> = { morze: 'Morze', gory: 'Góry', miasto: 'Miasto', zagranica: 'Zagranica' };
const fmt = (n: number) => new Intl.NumberFormat('pl-PL').format(n);
---

<AdminLayout title="Wycieczki — Panel TravelPL">
  <div class="flex items-center justify-between gap-4 mb-6">
    <div>
      <h1 class="text-2xl font-bold">Wycieczki</h1>
      <p class="text-sm text-slate-500">{trips.length} {trips.length === 1 ? 'wycieczka' : 'wycieczek'} w ofercie</p>
    </div>
    <a href="/admin/nowa" class="bg-blue-600 text-white font-semibold px-5 py-2.5 rounded-lg hover:bg-blue-700 transition-colors whitespace-nowrap">
      + Dodaj wycieczkę
    </a>
  </div>

  {trips.length === 0 ? (
    <p class="text-slate-500 bg-white rounded-2xl ring-1 ring-slate-200 p-10 text-center">
      Brak wycieczek. Kliknij „Dodaj wycieczkę", aby utworzyć pierwszą.
    </p>
  ) : (
    <div class="bg-white rounded-2xl ring-1 ring-slate-200 overflow-hidden">
      <table class="w-full text-sm">
        <thead class="bg-slate-50 text-slate-500 text-left">
          <tr>
            <th class="px-4 py-3 font-medium">Nazwa</th>
            <th class="px-4 py-3 font-medium hidden sm:table-cell">Region</th>
            <th class="px-4 py-3 font-medium hidden sm:table-cell">Cena</th>
            <th class="px-4 py-3 font-medium text-center">Wybierane</th>
            <th class="px-4 py-3 font-medium text-right">Akcje</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {trips.map((t) => (
            <tr class="hover:bg-slate-50">
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <img src={t.image} alt="" class="w-12 h-9 rounded object-cover bg-slate-100 shrink-0" />
                  <div>
                    <div class="font-semibold text-slate-900">{t.fullName}</div>
                    <div class="text-xs text-slate-400">/{t.slug}</div>
                  </div>
                </div>
              </td>
              <td class="px-4 py-3 hidden sm:table-cell text-slate-600">{regionLabels[t.region]}</td>
              <td class="px-4 py-3 hidden sm:table-cell text-slate-600">{fmt(t.price)} zł</td>
              <td class="px-4 py-3 text-center">
                {t.featured
                  ? <span class="inline-block px-2 py-0.5 rounded-full bg-green-100 text-green-700 text-xs font-semibold">TAK</span>
                  : <span class="text-slate-300">—</span>}
              </td>
              <td class="px-4 py-3">
                <div class="flex items-center justify-end gap-1">
                  <a href={`/admin/edytuj/${t.slug}`} class="px-3 py-1.5 rounded-lg text-blue-600 hover:bg-blue-50 font-medium">Edytuj</a>
                  <button type="button" data-slug={t.slug} data-name={t.fullName} class="delete-btn px-3 py-1.5 rounded-lg text-red-600 hover:bg-red-50 font-medium">Usuń</button>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  )}

  <script>
    document.querySelectorAll('.delete-btn').forEach((btn) => {
      btn.addEventListener('click', async () => {
        const el = btn as HTMLElement;
        const slug = el.dataset.slug!;
        const name = el.dataset.name || slug;
        if (!confirm(`Usunąć wycieczkę „${name}"? Tej operacji nie można cofnąć.`)) return;
        const res = await fetch('/api/admin/trips', {
          method: 'DELETE',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ slug }),
        });
        if (res.ok) location.reload();
        else alert('Nie udało się usunąć wycieczki.');
      });
    });
  </script>
</AdminLayout>
