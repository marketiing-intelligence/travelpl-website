---
// SSR (nie prerender) — dzięki temu strona wycieczki (SSR) może użyć Astro.rewrite('/404'),
// a my ustawiamy poprawny status 404.
Astro.response.status = 404;
import Layout from '../layouts/Layout.astro';
---

<Layout title="Nie znaleziono — TravelPL" description="Strona, której szukasz, nie istnieje.">
  <section class="max-w-3xl mx-auto px-4 py-28 md:py-40 text-center">
    <p
      class="text-7xl md:text-9xl font-extrabold text-primary mb-4 leading-none"
      style="font-family: 'Bricolage Grotesque', 'DM Sans', sans-serif;"
    >
      404
    </p>
    <h1 class="text-2xl md:text-3xl font-bold text-dark mb-4">Nie znaleźliśmy tej strony</h1>
    <p class="text-dark/60 mb-8 max-w-md mx-auto">
      Ta wycieczka mogła już się zakończyć albo adres jest nieprawidłowy. Sprawdź naszą aktualną ofertę.
    </p>
    <a
      href="/"
      class="inline-flex items-center justify-center gap-1.5 bg-primary text-white font-bold px-7 py-3.5 rounded-full shadow-cta-blue hover:bg-primary-dark hover:-translate-y-0.5 transition-all"
    >
      Wróć na stronę główną
      <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
    </a>
  </section>
</Layout>
