---
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import FeaturedTrips from '../components/FeaturedTrips.astro';
import Testimonials from '../components/Testimonials.astro';
import TripGrid from '../components/TripGrid.astro';
import DestinationsMarquee from '../components/DestinationsMarquee.astro';
import Contact from '../components/Contact.astro';
---

<Layout>
  <Hero />
  <FeaturedTrips />
  <Testimonials />
  <DestinationsMarquee />
  <TripGrid />

  <!-- Jak podróżujemy -->
  <section class="py-16 md:py-28 bg-white">
    <div class="max-w-7xl mx-auto px-4 sm:px-6">
      <div class="text-center mb-12 md:mb-16">
        <span class="eyebrow justify-center">Komfort podróży</span>
        <h2 class="section-title mb-4">Jak podróżujemy?</h2>
        <p class="section-lead max-w-xl mx-auto">Komfort i bezpieczeństwo przez całą drogę.</p>
      </div>
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-5 md:gap-8 max-w-4xl mx-auto">
        <div class="text-center p-8 bg-light rounded-3xl ring-1 ring-dark/5 hover:-translate-y-1 hover:shadow-card transition-all duration-300">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white text-primary shadow-card mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M8 2v4"/><path d="M16 2v4"/><path d="M21 12.5V6a2 2 0 0 0-2-2H5a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h7.5"/><path d="m15.5 17.5 2 2 4-4"/></svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-2">Klimatyzacja</h3>
          <p class="text-dark/65 text-base leading-relaxed">Przyjemna temperatura niezależnie od pogody</p>
        </div>
        <div class="text-center p-8 bg-light rounded-3xl ring-1 ring-dark/5 hover:-translate-y-1 hover:shadow-card transition-all duration-300">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white text-primary shadow-card mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 12h.01"/><path d="M16 6V4a2 2 0 0 0-2-2h-4a2 2 0 0 0-2 2v2"/><rect width="20" height="14" x="2" y="6" rx="2"/></svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-2">Wygodne fotele</h3>
          <p class="text-dark/65 text-base leading-relaxed">Rozkładane siedzenia z dużą ilością miejsca na nogi</p>
        </div>
        <div class="text-center p-8 bg-light rounded-3xl ring-1 ring-dark/5 hover:-translate-y-1 hover:shadow-card transition-all duration-300">
          <div class="inline-flex items-center justify-center w-16 h-16 rounded-2xl bg-white text-primary shadow-card mb-5">
            <svg xmlns="http://www.w3.org/2000/svg" width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M18 8h1a4 4 0 0 1 0 8h-1"/><path d="M2 8h16v9a4 4 0 0 1-4 4H6a4 4 0 0 1-4-4V8z"/><line x1="6" y1="1" x2="6" y2="4"/><line x1="10" y1="1" x2="10" y2="4"/><line x1="14" y1="1" x2="14" y2="4"/></svg>
          </div>
          <h3 class="text-xl font-bold text-dark mb-2">Przerwy w trasie</h3>
          <p class="text-dark/65 text-base leading-relaxed">Regularne postoje na kawę i odpoczynek</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Banner szkolny -->
  <section class="px-2 sm:px-4 pb-2 sm:pb-4">
    <div class="frame bg-gradient-to-br from-primary to-primary-dark relative max-w-[110rem] mx-auto py-14 md:py-20">
      <div class="absolute -top-16 -right-16 w-64 h-64 bg-white/5 rounded-full"></div>
      <div class="absolute -bottom-24 -left-10 w-72 h-72 bg-white/5 rounded-full"></div>
      <div class="max-w-5xl mx-auto px-4 sm:px-6 text-center relative">
        <p class="text-white text-2xl md:text-3xl font-bold mb-6 tracking-tight" style="font-family: 'Bricolage Grotesque', 'DM Sans', sans-serif;">
          Organizujesz wycieczkę szkolną?
        </p>
        <a
          href="/wycieczki-szkolne"
          class="btn-white"
        >
          Zobacz naszą ofertę dla szkół
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
        </a>
      </div>
    </div>
  </section>

  <Contact />
</Layout>
