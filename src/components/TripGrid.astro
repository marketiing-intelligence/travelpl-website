---
import { trips } from '../data/trips';
import TripCard from './TripCard.astro';
---

<section id="oferta" class="py-16 md:py-28 scroll-mt-20">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="section-head">
      <div>
        <span class="eyebrow">Pełna oferta</span>
        <h2 class="section-title">Oferta wczasów 2026</h2>
      </div>
      <p class="section-lead max-w-md lg:text-right lg:pb-2">
        Zaplanuj urlop z wyprzedzeniem i miej wakacje z głowy. Wyjazdy od maja do września — morze, góry, miasta i wyjątkowe regiony Polski.
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {trips.map((trip, i) => (
        <div class="reveal" style={`animation-delay: ${(i % 3) * 100}ms`}>
          <TripCard trip={trip} />
        </div>
      ))}
    </div>
  </div>
</section>
