---
const testimonials = [
  {
    text: 'Jeżdżę z TravelPL od 3 lat — każda wycieczka to sama przyjemność. Organizacja na medal!',
    author: 'Elżbieta',
    location: 'Wieruszów',
  },
  {
    text: 'Nie muszę się o nic martwić. Wsiadam w autokar i mam wakacje z głowy.',
    author: 'Krzysztof',
    location: 'Kępno',
  },
  {
    text: 'Byliśmy z żoną w Bieszczadach — piękne widoki, świetny przewodnik i jedzenie rewelacja.',
    author: 'Marek i Anna',
    location: '',
  },
];

const stats = [
  { value: '12', count: 12, suffix: '', label: 'wycieczek w sezonie 2026' },
  { value: '10+', count: 10, suffix: '+', label: 'lat doświadczenia' },
  { value: '100%', count: 100, suffix: '%', label: 'wyjazd z Wieruszowa' },
];
---

<section class="px-2 sm:px-4 pt-2 sm:pt-4">
  <div class="frame bg-dark max-w-[110rem] mx-auto py-16 md:py-24 relative">
    <div class="absolute -top-24 -right-24 w-96 h-96 bg-primary/15 rounded-full blur-3xl"></div>
    <div class="absolute -bottom-32 -left-20 w-96 h-96 bg-accent/10 rounded-full blur-3xl"></div>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 relative">

    <!-- Heading -->
    <div class="section-head">
      <div>
        <span class="eyebrow bg-white/10 text-white">Opinie</span>
        <h2 class="section-title text-white">Co mówią nasi podróżnicy?</h2>
      </div>
      <p class="section-lead text-white/65 max-w-md lg:text-right lg:pb-2">
        Zadowolenie naszych klientów to najlepsza rekomendacja.
      </p>
    </div>

    <!-- Testimonials -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-5 md:gap-6 mb-14 md:mb-20">
      {testimonials.map((t, i) => (
        <blockquote class={`rounded-3xl p-7 md:p-8 relative flex flex-col bg-white/[0.06] ring-1 ring-white/10 backdrop-blur reveal`} style={`animation-delay: ${i * 120}ms`}>
          <!-- Quote icon -->
          <svg class="text-accent/60 mb-5" xmlns="http://www.w3.org/2000/svg" width="38" height="38" viewBox="0 0 24 24" fill="currentColor">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <p class="text-white/90 text-xl leading-relaxed mb-6 flex-1" style="font-family: 'Bricolage Grotesque', 'DM Sans', sans-serif;">
            „{t.text}"
          </p>
          <footer class="flex items-center gap-3 pt-4 border-t border-white/10">
            <span class="flex items-center justify-center w-11 h-11 rounded-full bg-accent/20 text-accent font-extrabold text-lg shrink-0">
              {t.author.charAt(0)}
            </span>
            <span class="font-bold text-white leading-tight">
              {t.author}
              {t.location && <span class="block font-medium text-sm text-white/50">z {t.location}</span>}
            </span>
          </footer>
        </blockquote>
      ))}
    </div>

    <!-- Stats bar -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 max-w-4xl mx-auto">
      {stats.map((stat) => (
        <div class="text-center rounded-3xl py-7 px-4 ring-1 ring-white/10 bg-white/[0.04]">
          <div class="text-5xl md:text-6xl font-extrabold tracking-tight text-white tabular-nums" style="font-family: 'Bricolage Grotesque', 'DM Sans', sans-serif;" data-count={stat.count} data-suffix={stat.suffix}>{stat.value}</div>
          <div class="text-base text-white/60 mt-2 font-medium">{stat.label}</div>
        </div>
      ))}
    </div>

  </div>
  </div>
</section>
