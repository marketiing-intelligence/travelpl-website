---
const testimonials = [
  {
    text: 'Jeżdżę z TravelPL od 3 lat — każda wycieczka to sama przyjemność. Organizacja na medal!',
    author: 'Elżbieta',
    location: 'Wieruszów',
  },
  {
    text: 'Nie muszę się o nic martwić. Wsiadam w autokar i mam wakacje z głowy.',
    author: 'Krzysztof',
    location: 'Kępno',
  },
  {
    text: 'Byliśmy z żoną w Bieszczadach — piękne widoki, świetny przewodnik i jedzenie rewelacja.',
    author: 'Marek i Anna',
    location: '',
  },
];

const stats = [
  { value: '12', label: 'wycieczek w sezonie 2026' },
  { value: '10+', label: 'lat doświadczenia' },
  { value: '100%', label: 'wyjazd z Wieruszowa' },
];
---

<section class="px-2 sm:px-4 pt-2 sm:pt-4">
  <div class="frame bg-sand max-w-[110rem] mx-auto py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">

    <!-- Stats bar -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 sm:gap-6 mb-14 md:mb-20 max-w-4xl mx-auto">
      {stats.map((stat) => (
        <div class="text-center bg-white/70 backdrop-blur rounded-3xl py-6 px-4 ring-1 ring-dark/5">
          <div class="text-4xl md:text-5xl font-extrabold tracking-tight text-primary">{stat.value}</div>
          <div class="text-base text-dark/65 mt-2 font-medium">{stat.label}</div>
        </div>
      ))}
    </div>

    <!-- Heading -->
    <div class="text-center mb-12 md:mb-16">
      <span class="eyebrow justify-center">Opinie</span>
      <h2 class="section-title mb-4">Co mówią nasi podróżnicy?</h2>
      <p class="section-lead max-w-xl mx-auto">
        Zadowolenie naszych klientów to najlepsza rekomendacja.
      </p>
    </div>

    <!-- Testimonials -->
    <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">
      {testimonials.map((t) => (
        <blockquote class="card p-7 md:p-8 relative flex flex-col">
          <!-- Quote icon -->
          <svg class="text-accent/25 mb-5" xmlns="http://www.w3.org/2000/svg" width="38" height="38" viewBox="0 0 24 24" fill="currentColor">
            <path d="M14.017 21v-7.391c0-5.704 3.731-9.57 8.983-10.609l.995 2.151c-2.432.917-3.995 3.638-3.995 5.849h4v10h-9.983zm-14.017 0v-7.391c0-5.704 3.748-9.57 9-10.609l.996 2.151c-2.433.917-3.996 3.638-3.996 5.849h3.983v10h-9.983z" />
          </svg>
          <p class="text-dark/85 text-lg leading-relaxed mb-6 flex-1">
            „{t.text}"
          </p>
          <footer class="flex items-center gap-3 pt-4 border-t border-dark/5">
            <span class="flex items-center justify-center w-11 h-11 rounded-full bg-primary-soft text-primary font-extrabold text-lg shrink-0">
              {t.author.charAt(0)}
            </span>
            <span class="font-bold text-dark leading-tight">
              {t.author}
              {t.location && <span class="block font-medium text-sm text-dark/50">z {t.location}</span>}
            </span>
          </footer>
        </blockquote>
      ))}
    </div>

  </div>
  </div>
</section>
