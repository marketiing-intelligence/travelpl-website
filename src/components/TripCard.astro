---
import type { Trip } from '../data/trips';

interface Props {
  trip: Trip;
}

const { trip } = Astro.props;

const formattedPrice = new Intl.NumberFormat('pl-PL').format(trip.price);

const regionColors: Record<string, string> = {
  morze: 'bg-primary text-white',
  gory: 'bg-success text-white',
  miasto: 'bg-accent text-white',
  zagranica: 'bg-amber-600 text-white',
};

const regionLabels: Record<string, string> = {
  morze: 'Morze',
  gory: 'Góry',
  miasto: 'Miasto',
  zagranica: 'Zagranica',
};

const typeLabel = trip.type === 'wczasy' ? 'Wczasy' : 'Wycieczka';
---

<article class="group card tilt overflow-hidden hover:shadow-card-hover flex flex-col h-full">
  <!-- Image -->
  <div class="relative h-52 md:h-56 bg-gradient-to-br from-primary/15 to-accent/15 overflow-hidden">
    {trip.image ? (
      <img
        src={trip.image}
        alt={trip.fullName}
        class="absolute inset-0 w-full h-full object-cover parallax-img transition-transform duration-700 ease-out group-hover:scale-105"
        loading="lazy"
        transition:name={`trip-img-${trip.slug}`}
      />
    ) : (
      <span class="absolute inset-0 flex items-center justify-center text-primary/40 text-3xl font-bold">{trip.name}</span>
    )}
    <div class="absolute inset-x-0 bottom-0 h-20 bg-gradient-to-t from-dark/60 to-transparent"></div>

    <span class={`absolute top-4 left-4 text-sm font-bold px-3.5 py-1.5 rounded-full shadow-sm ${regionColors[trip.region]}`}>
      {regionLabels[trip.region]}
    </span>
    {(trip.urgencyBadge || trip.badge) && (
      <span class={`absolute top-4 right-4 text-white text-sm font-bold px-3.5 py-1.5 rounded-full shadow-sm ${trip.urgencyBadge ? 'bg-red-600 animate-pulse' : 'bg-accent'}`}>
        {trip.urgencyBadge || trip.badge}
      </span>
    )}

    <!-- Dates chip on image -->
    <span class="absolute bottom-3.5 left-4 inline-flex items-center gap-1.5 text-white text-sm font-semibold drop-shadow">
      <svg xmlns="http://www.w3.org/2000/svg" width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2" ry="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
      {trip.dates}
      <span class="opacity-70 mx-0.5">·</span>
      {trip.duration}
    </span>

    <!-- Price glass chip -->
    <span class="absolute bottom-3 right-3 inline-flex items-baseline gap-1 bg-white/95 backdrop-blur-md text-dark font-extrabold text-lg px-4 py-1.5 rounded-full shadow-card">
      <span class="text-xs font-semibold text-dark/50">od</span>
      {formattedPrice} zł
      <span class="text-xs font-semibold text-dark/50">/os</span>
    </span>
  </div>

  <!-- Content -->
  <div class="p-6 flex flex-col flex-1">
    <h3 class="text-xl md:text-[1.35rem] font-bold tracking-tight text-dark mb-2 leading-snug">{trip.fullName}</h3>

    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class="inline-flex items-center bg-light text-dark/70 text-sm font-semibold px-3 py-1 rounded-full">{typeLabel}</span>
      {trip.beachDistance && (
        <span class="inline-flex items-center gap-1 bg-primary-soft text-primary text-sm font-semibold px-3 py-1 rounded-full">
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 12h20"/><path d="M2 17h20"/><path d="M2 7h20"/></svg>
          {trip.beachDistance}
        </span>
      )}
    </div>

    <p class="text-dark/70 text-base leading-relaxed mb-5 flex-1">{trip.shortDescription}</p>

    <div class="grid grid-cols-2 gap-3 mt-auto pt-4 border-t border-dark/5">
      <a
        href={`/wycieczka/${trip.slug}`}
        class="inline-flex items-center justify-center gap-1.5 bg-primary text-white font-bold py-3 rounded-full shadow-cta-blue hover:bg-primary-dark hover:-translate-y-0.5 transition-all text-base min-h-touch"
      >
        Więcej
        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
      <a
        href="tel:+48793705063"
        class="inline-flex items-center justify-center gap-2 text-accent font-bold text-base py-3 rounded-full hover:bg-accent-soft transition-colors min-h-touch border-2 border-accent/25"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
      Zadzwoń
      </a>
    </div>
  </div>
</article>
