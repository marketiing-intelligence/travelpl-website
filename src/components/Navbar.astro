---
const navItems = [
  { label: 'Oferta', href: '/#oferta' },
  { label: 'Wycieczki szkolne', href: '/wycieczki-szkolne' },
  { label: 'O nas', href: '/o-nas' },
  { label: 'Aplikacja', href: '/aplikacja' },
  { label: 'Kontakt', href: '/#kontakt' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '');
const isActive = (href: string) =>
  !href.includes('#') && pathname === href.replace(/\/$/, '');
---

<header id="navbar" class="sticky top-0 z-50 bg-white/90 backdrop-blur-xl border-b border-dark/5 transition-shadow">
  <nav class="max-w-7xl mx-auto px-4 sm:px-6 flex items-center justify-between h-16 md:h-20">
    <!-- Logo -->
    <a href="/" class="text-[1.7rem] md:text-3xl font-extrabold text-primary tracking-tight leading-none" style="font-family: 'Bricolage Grotesque', 'DM Sans', sans-serif;">
      Travel<span class="text-accent">PL</span>
    </a>

    <!-- Desktop nav -->
    <ul class="hidden lg:flex items-center gap-9">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class={`relative py-2 font-semibold text-[17px] transition-colors after:absolute after:left-0 after:-bottom-0.5 after:h-0.5 after:bg-accent after:rounded-full after:transition-all ${
              isActive(item.href)
                ? 'text-primary after:w-full'
                : 'text-dark/75 hover:text-primary after:w-0 hover:after:w-full'
            }`}
          >
            {item.label}
          </a>
        </li>
      ))}
    </ul>

    <div class="hidden lg:block">
      <a
        href="tel:+48793705063"
        class="inline-flex items-center gap-2 bg-accent text-white font-bold px-7 py-3 rounded-full shadow-cta hover:bg-accent-dark hover:-translate-y-0.5 transition-all text-[17px]"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        793 705 063
      </a>
    </div>

    <!-- Mobile: phone + hamburger -->
    <div class="flex items-center gap-2 lg:hidden">
      <a
        href="tel:+48793705063"
        class="inline-flex items-center justify-center gap-1.5 text-accent font-bold text-[16px] w-11 h-11 sm:w-auto sm:h-auto sm:px-4 sm:py-2.5 rounded-full bg-accent-soft hover:bg-accent/15 transition-colors whitespace-nowrap"
        aria-label="Zadzwoń: 793 705 063"
      >
        <svg xmlns="http://www.w3.org/2000/svg" width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
        <span class="hidden sm:inline">793 705 063</span>
      </a>
      <button
        id="menu-toggle"
        class="p-2.5 rounded-xl hover:bg-light transition-colors"
        aria-label="Otwórz menu"
        aria-expanded="false"
      >
        <svg id="menu-icon-open" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
        <svg id="menu-icon-close" class="hidden" xmlns="http://www.w3.org/2000/svg" width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
      </button>
    </div>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden bg-white/95 backdrop-blur-xl border-t border-dark/5 shadow-card">
    <ul class="flex flex-col py-4 px-4 gap-1">
      {navItems.map((item) => (
        <li>
          <a
            href={item.href}
            class={`block py-3.5 px-5 rounded-2xl font-semibold text-body transition-colors ${
              isActive(item.href) ? 'text-primary bg-primary-soft' : 'text-dark hover:text-primary hover:bg-primary-soft'
            }`}
          >
            {item.label}
          </a>
        </li>
      ))}
      <li class="mt-2 px-1">
        <a
          href="tel:+48793705063"
          class="flex items-center justify-center gap-2 bg-accent text-white font-bold py-4 rounded-full shadow-cta text-body"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"/></svg>
          Zadzwoń: 793 705 063
        </a>
      </li>
    </ul>
  </div>
</header>

<script>
  document.addEventListener('astro:page-load', () => {
    const toggle = document.getElementById('menu-toggle');
    const menu = document.getElementById('mobile-menu');
    const iconOpen = document.getElementById('menu-icon-open');
    const iconClose = document.getElementById('menu-icon-close');

    toggle?.addEventListener('click', () => {
      const isOpen = menu?.classList.toggle('hidden') === false;
      iconOpen?.classList.toggle('hidden', isOpen);
      iconClose?.classList.toggle('hidden', !isOpen);
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    // Close mobile menu on link click
    menu?.querySelectorAll('a').forEach((link) => {
      link.addEventListener('click', () => {
        menu.classList.add('hidden');
        iconOpen?.classList.remove('hidden');
        iconClose?.classList.add('hidden');
        toggle?.setAttribute('aria-expanded', 'false');
      });
    });
  });

  // Shadow on scroll — single global listener, re-queries DOM
  const onScroll = () => document.getElementById('navbar')?.classList.toggle('shadow-card', window.scrollY > 8);
  window.addEventListener('scroll', onScroll, { passive: true });
  document.addEventListener('astro:page-load', onScroll);
</script>
