---
import { trips } from '../data/trips';
import TripCard from './TripCard.astro';

const featured = trips.filter((t) => t.featured);
---

<section class="px-2 sm:px-4 pt-10 sm:pt-14 scroll-mt-20">
  <div class="frame bg-light max-w-[110rem] mx-auto py-16 md:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6">
    <div class="text-center mb-12 md:mb-16">
      <span class="eyebrow justify-center">Hity sezonu</span>
      <h2 class="section-title mb-4">Najczęściej wybierane</h2>
      <p class="section-lead max-w-xl mx-auto">
        Te wyjazdy cieszą się największym zainteresowaniem — sprawdź, czy zostały jeszcze miejsca!
      </p>
    </div>
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6 md:gap-8">
      {featured.map((trip, i) => (
        <div class="reveal" style={`animation-delay: ${i * 150}ms`}>
          <TripCard trip={trip} />
        </div>
      ))}
    </div>
  </div>
  </div>
</section>
